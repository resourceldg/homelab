# Variables del stack de ThingsBoard. En el servidor el .env lo escribe el rol
# Ansible `thingsboard` (root, 0600) con secretos sorteados en el host
# (/etc/thingsboard/secrets). Este archivo es solo de referencia: NO poner
# secretos reales en el repo.
TZ=America/Argentina/Buenos_Aires
# demo = simulador de placas; publico = nodo Tailscale "tableros" con Funnel.
COMPOSE_PROFILES=demo
TB_VERSION=4.3.1.6
# Heap fijo y chico: el server comparte RAM con el aula y una VM (ver README).
TB_JAVA_OPTS=-Xms512m -Xmx1024m -XX:MaxMetaspaceSize=320m -XX:ReservedCodeCacheSize=128m -Xss512k
TB_MEM_LIMIT=1792m
# 30 días
TB_TTL_SEGUNDOS=2592000
TB_HTTP_PORT=18080
TB_DB_PASSWORD=cambiar
TB_MONITOREO_DB_PASSWORD=cambiar
# openssl rand -base64 64 | tr -d '\n'
TB_JWT_SIGNING_KEY=cambiar
# Cuenta tb-puente de mqtt-aula (solo lectura) y token del gateway en ThingsBoard
TB_PUENTE_MQTT_PASS=cambiar
TB_PUENTE_TOKEN=cambiar
TB_PUENTE_TOPICS=equipo-01/#,demo-meteo/#,demo-seguridad/#,demo-ambiente/#
# Cuenta tb-demo de mqtt-aula (escribe solo en demo-*)
TB_DEMO_MQTT_PASS=cambiar
TB_BACKUP_DIR=/var/backups/thingsboard
TB_PORTADA_DIR=/srv/tableros
# Auth key de Tailscale para el nodo "tableros" (solo la primera vez)
TS_AUTHKEY=

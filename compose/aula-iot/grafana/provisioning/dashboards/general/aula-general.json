      "type": "prometheus",
      "uid": "mqtt-aula"
     },
     "expr": "last_over_time(mqtt_valor[15d])",
     "instant": true,
     "format": "table"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "mqtt-aula"
     },
     "expr": "time() - tlast_over_time(mqtt_valor[15d])",
     "instant": true,
     "format": "table"
    }
   ],

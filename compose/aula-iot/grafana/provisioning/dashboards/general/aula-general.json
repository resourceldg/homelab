   "description": "Cuánto publica cada equipo. Un pico enorme suele ser una placa en un bucle sin delay.",
   "datasource": {
    "type": "prometheus",
    "uid": "mqtt-aula"
   },
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 24,

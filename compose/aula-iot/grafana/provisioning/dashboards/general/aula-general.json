   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "mqtt-aula"
     },
     "expr": "sum by (equipo) (count_over_time(mqtt_valor[1m]))",
     "legendFormat": "{{equipo}}",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,

    {
      "id": 8,
      "type": "barchart",
      "title": "Arranques por causa (20 días)",
      "description": "Cómo terminó el encendido anterior a cada arranque (resúmenes del post-mortem).",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8

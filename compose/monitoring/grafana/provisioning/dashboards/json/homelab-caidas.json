                        "color": "red",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "(.*vigía.*)",
                      "result": {
                        "color": "orange",
                        "index": 1
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "(.*botón.*)",
                      "result": {
                        "color": "purple",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Arranque",
            "desc": true
          }
        ]
      },

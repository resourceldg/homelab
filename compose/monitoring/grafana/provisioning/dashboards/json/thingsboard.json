    {
      "id": 21,
      "type": "timeseries",
      "title": "PostgreSQL: transacciones y conexiones",
      "description": "Transacciones por segundo y conexiones abiertas de la base de ThingsBoard.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 39
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "rate(pg_stat_database_xact_commit{datname=\"thingsboard\"}[5m])",
          "legendFormat": "transacciones/s"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "pg_stat_database_numbackends{datname=\"thingsboard\"}",
          "legendFormat": "conexiones"
        }
      ],
      "options": {
        "legend": {

{% set team = item.item.name %}
{% set tid = team | replace('-', '_') %}
{% set pgpass = item.content | b64decode %}
{% set mqttpass = team_mqttpass.results[team_index].content | b64decode %}
# {{ ansible_managed }}
# Credenciales de servicios compartidos para el {{ team }}.
# Estos hostnames resuelven dentro de la red de tu proyecto (labctl los conecta).

# --- PostgreSQL (base de datos propia del equipo) ---
PGHOST=postgres
PGPORT=5432
PGDATABASE=db_{{ tid }}
PGUSER={{ tid }}
PGPASSWORD={{ pgpass }}
DATABASE_URL=postgresql://{{ tid }}:{{ pgpass }}@postgres:5432/db_{{ tid }}

# --- Redis (base lógica propia del equipo) ---
REDIS_URL=redis://redis:6379/{{ team_index + 1 }}

# --- Mailpit (SMTP de prueba, sin autenticación) ---
SMTP_HOST=mailpit
SMTP_PORT=1025

# --- MQTT (broker del aula: mqtt-aula) ---
# Broker compartido y CERRADO: entrás con este usuario/clave y solo podés usar
# topics que empiecen con `{{ team }}/` (p. ej. `{{ team }}/led`).
# Desde tu Node-RED (dentro de la red de tu proyecto):
MQTT_HOST=mqtt-aula
MQTT_PORT=1883
MQTT_USER={{ tid }}
MQTT_PASSWORD={{ mqttpass }}
MQTT_TOPIC_PREFIX={{ team }}/
{% if shared_mqtt_funnel_enabled | bool %}
# Desde un dispositivo (ESP32), por internet con TLS (mismo usuario/clave):
MQTT_DEVICE_HOST={{ shared_mqtt_public_host }}
MQTT_DEVICE_PORT={{ shared_mqtt_funnel_port }}
{% endif %}

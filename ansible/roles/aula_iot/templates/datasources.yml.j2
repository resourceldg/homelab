# {{ ansible_managed }}
apiVersion: 1

# Org 1 = la del OPERADOR: solo la fuente con todos los equipos (la usa el
# tablero general). La fuente de cada equipo vive en la ORGANIZACIÓN de ese
# equipo y la crea files/aula_grafana.py: Grafana OSS no tiene permisos por
# fuente de datos, así que una fuente de equipo en la org 1 la podía consultar
# cualquiera que estuviera en la org 1.

# Las fuentes de equipo que vivían en la org 1 (diseño anterior) se borran.
deleteDatasources:
{% for team in classroom_teams %}
  - name: "MQTT — {{ team.name }}"
    orgId: 1
{% endfor %}
{% for ds in aula_iot_datasources_removed | default([]) %}
  - name: "{{ ds }}"
    orgId: 1
{% endfor %}

datasources:
  - name: "MQTT — Aula (todos)"
    uid: mqtt-aula
    orgId: 1
    type: prometheus
    access: proxy
    url: http://aula-victoriametrics:8428
    isDefault: true
    editable: false
    jsonData:
      timeInterval: "10s"

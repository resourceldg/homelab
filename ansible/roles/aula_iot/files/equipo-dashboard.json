     "uid": "mqtt-__EQUIPO__"
    },
    "gridPos": {
     "x": 0,
     "y": 3,
     "w": 8,
     "h": 4
    },
    "targets": [
     {
      "refId": "A",
      "datasource": {
       "type": "prometheus",
       "uid": "mqtt-__EQUIPO__"
      },
      "expr": "count(count by (dispositivo) (last_over_time(mqtt_valor[5m]))) or vector(0)",
      "instant": true
     }
    ],
    "fieldConfig": {
     "defaults": {
      "unit": "short",
      "decimals": 0,
      "color": {
       "mode": "thresholds"

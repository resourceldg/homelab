    "title": "Actuadores y estados (ON/OFF)",
    "datasource": {
     "type": "prometheus",
     "uid": "mqtt-__EQUIPO__"
    },
    "description": "Para actuadores y sensores de dos estados (ON/OFF, abierto/cerrado, online/offline). 1 = encendido/abierto/online, 0 = apagado/cerrado/offline.",
    "gridPos": {
     "x": 0,
     "y": 15,
     "w": 24,
     "h": 6
    },
    "targets": [
     {
      "refId": "A",
      "datasource": {
       "type": "prometheus",
       "uid": "mqtt-__EQUIPO__"
      },
      "expr": "mqtt_valor and on(equipo, dispositivo, magnitud) (max_over_time(mqtt_valor[15d]) <= 1 and min_over_time(mqtt_valor[15d]) >= 0)",
      "legendFormat": "{{dispositivo}} · {{magnitud}}",
      "range": true
     }
    ],
    "fieldConfig": {
     "defaults": {
      "color": {
       "mode": "thresholds"
      },
      "thresholds": {
       "mode": "absolute",
       "steps": [
        {
         "color": "#5a6270",
         "value": null
        },
        {
         "color": "green",
         "value": 1
        }
       ]
      },
      "mappings": [
       {
        "type": "value",
        "options": {
         "0": {
          "text": "OFF / cerrado",
          "color": "#5a6270"
         },
         "1": {
          "text": "ON / abierto",
          "color": "green"
         }
        }

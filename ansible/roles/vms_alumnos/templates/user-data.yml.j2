#cloud-config
# {{ ansible_managed }}
# Primer arranque de la VM de {{ item.owner }}. cloud-init lo aplica UNA vez:
# cambiar esto después no toca una VM ya creada.
hostname: {{ item.name }}
users:
  - name: {{ item.owner }}
    shell: /bin/bash
    groups: [sudo]
    # Es SU máquina: root sin contraseña (no tiene contraseña, entra con llave).
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    ssh_authorized_keys:
{% for key in item.ssh_pubkeys %}
      - {{ key }}
{% endfor %}
ssh_pwauth: false
disable_root: true
package_update: true
packages:
  - openssh-server
# Sin contraseña pero NO bloqueada. cloud-init deja la cuenta con "!" (bloqueada),
# y el sshd de Ubuntu rechaza una cuenta bloqueada aunque la llave sea correcta
# ("User ... not allowed because account is locked"). "*" = no hay contraseña
# con la que entrar, pero la cuenta está activa y la llave funciona.
runcmd:
  - [usermod, -p, "*", "{{ item.owner }}"]

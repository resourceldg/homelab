# {{ ansible_managed }}
# Secretos del stack de ThingsBoard (root, 0600). Los valores salen de
# {{ thingsboard_secrets_dir }} y de las cuentas de mqtt-aula de shared_services.
TZ={{ server_timezone | default('America/Argentina/Buenos_Aires') }}
COMPOSE_PROFILES={{ thingsboard_profiles | join(',') }}
TB_VERSION={{ thingsboard_version }}
TB_JAVA_OPTS={{ thingsboard_java_opts }}
TB_MEM_LIMIT={{ thingsboard_mem_limit }}
TB_TTL_SEGUNDOS={{ thingsboard_ttl_dias * 86400 }}
TB_HTTP_PORT={{ thingsboard_http_port }}
TB_DB_PASSWORD={{ thingsboard_db_password }}
TB_MONITOREO_DB_PASSWORD={{ thingsboard_monitoreo_password }}
TB_JWT_SIGNING_KEY={{ thingsboard_jwt_key }}
TB_PUENTE_MQTT_PASS={{ thingsboard_puente_mqtt_pass }}
TB_PUENTE_TOKEN={{ thingsboard_gateway_token }}
TB_TOKENS_EQUIPOS={{ thingsboard_tokens_equipos }}
TB_PUENTE_TOPICS={{ ((classroom_teams | map(attribute='name') | list) + (thingsboard_demo_proyectos if thingsboard_demo_enabled | bool else [])) | map('regex_replace', '$', '/#') | join(',') }}
TB_DEMO_MQTT_PASS={{ thingsboard_demo_mqtt_pass }}
TB_BACKUP_DIR={{ thingsboard_backup_dir }}
TB_PORTADA_DIR={{ thingsboard_portada_dir }}
TS_AUTHKEY={{ thingsboard_ts_authkey }}

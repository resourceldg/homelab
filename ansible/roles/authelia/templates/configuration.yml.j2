# {{ ansible_managed }}
theme: dark

server:
  address: 'tcp://:9091'

log:
  level: info

identity_validation:
  reset_password:
    jwt_secret: '{{ vault_authelia_jwt_secret }}'

# Freno a quien prueba claves: 5 fallos en 2 min → ese usuario queda bloqueado
# 5 min. Explícito (Authelia trae algo parecido por defecto) para que se vea y
# coincida con lo que dice el manual (cap. 13, paso 1). 5 y no 3: los chicos se
# equivocan tipeando, y las claves del aula son largas (scripts/claves-aula.sh).
regulation:
  max_retries: 5
  find_time: '2 minutes'
  ban_time: '5 minutes'

authentication_backend:
  file:
    path: /config/users_database.yml
    password:
      algorithm: sha2crypt
      sha2crypt:
        variant: sha512

access_control:
  default_policy: deny
  rules:
    # The login portal itself must always be reachable.
    - domain: 'auth.{{ caddy_base_domain }}'
      policy: bypass
    # Metrics backends: operators only.
    - domain:
        - 'prometheus.{{ caddy_base_domain }}'
        - 'cadvisor.{{ caddy_base_domain }}'
      policy: one_factor
      subject: ['group:operators']
    # Pañol IoT dashboard: operators only — it acts on a real door.
    - domain: '{{ panol_subdomain | default("panol") }}.{{ caddy_base_domain }}'
      policy: one_factor
      subject: ['group:operators']
    # Grafana de operación: infra + auditoría del pañol (quién entró y cuándo).
    # Solo operadores. Los alumnos tienen el suyo en grafana-aula.
    - domain: 'grafana.{{ caddy_base_domain }}'
      policy: one_factor
      subject: ['group:operators']
    # Grafana del aula + el launchpad: operadores y alumnos.
    - domain:
        - 'grafana-aula.{{ caddy_base_domain }}'
        - '{{ caddy_base_domain }}'
      policy: one_factor
      subject: ['group:operators', 'group:students']

session:
  secret: '{{ vault_authelia_session_secret }}'
  cookies:
    - domain: '{{ caddy_base_domain }}'
      authelia_url: 'https://auth.{{ caddy_base_domain }}'
      default_redirection_url: 'https://{{ caddy_base_domain }}'
      expiration: '1 hour'
      inactivity: '15 minutes'

storage:
  encryption_key: '{{ vault_authelia_storage_key }}'
  local:
    path: /config/db.sqlite3

notifier:
  # File notifier: password-reset links land in this file (no SMTP needed).
  filesystem:
    filename: /config/notification.txt
